<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PUPSISPortal.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PUPSISPortal.App.Views"
    Title="PUPSISPortal">

    <!-- Mica: the closest Windows analog to the macOS Liquid Glass ground. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom, draggable title strip (SetTitleBar in code-behind). -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid>
                <TextBlock Text="PUPSISPortal" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <!-- Screen switcher — plain buttons, not a NavigationView, to match
                     the minimal Stage 3-5 shell rather than pull in a heavier chrome. -->
                <StackPanel x:Name="NavButtons" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="NavCalendarButton" Content="Calendar" Click="OnNavCalendar" />
                    <Button x:Name="NavNotesButton" Content="Notes" Click="OnNavNotes" />
                    <Button x:Name="NavGradesButton" Content="Grades" Click="OnNavGrades" />
                </StackPanel>

                <!-- Integrations: .ics export, Google Calendar, startup — kept in one
                     flyout rather than a dedicated Settings screen for now. -->
                <Button x:Name="MoreButton" Content="…" HorizontalAlignment="Right"
                        Margin="0,0,16,0" Visibility="Collapsed">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Export schedule (.ics)…" Click="OnExportIcs" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="GoogleMenuItem" Text="Connect Google Calendar…" Click="OnGoogleConnect" />
                            <MenuFlyoutItem Text="Export to Google Calendar" Click="OnGoogleExport" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="StartupMenuItem" Text="Start with Windows" Click="OnToggleStartup" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:CalendarView x:Name="Calendar" Margin="16" Visibility="Collapsed" />
            <views:NotesPage x:Name="Notes" Visibility="Collapsed" />
            <views:GradesView x:Name="Grades" Visibility="Collapsed" />

            <!-- The update nudge: checked at startup against GitHub releases,
                 never a self-updater — this just links out. -->
            <InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False"
                     Title="Update available" IsClosable="True"
                     VerticalAlignment="Top" Margin="16,8">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateBarButton" Content="View release" Click="OnViewUpdate" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel x:Name="SignInPanel" Width="320" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sign in to PUP SIS" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="StudNo" Header="Student number" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="BMonth" Header="MM" Width="70" />
                    <NumberBox x:Name="BDay" Header="DD" Width="70" />
                    <NumberBox x:Name="BYear" Header="YYYY" Width="96" />
                </StackPanel>
                <PasswordBox x:Name="Pwd" Header="Password" />
                <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn"
                        HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock x:Name="Status" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- The session's hidden webview: never shown, holds the auth cookies. -->
            <WebView2 x:Name="Web" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
