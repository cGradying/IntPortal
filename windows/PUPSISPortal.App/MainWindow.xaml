<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PUPSISPortal.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PUPSISPortal.App.Views"
    Title="PUPSISPortal">

    <!-- Mica: the closest Windows analog to the macOS Liquid Glass ground. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom, draggable title strip (SetTitleBar in code-behind). -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Text="PUPSISPortal" Margin="16,0,0,0"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1">
            <views:CalendarView x:Name="Calendar" Margin="16" Visibility="Collapsed" />

            <StackPanel x:Name="SignInPanel" Width="320" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sign in to PUP SIS" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="StudNo" Header="Student number" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="BMonth" Header="MM" Width="70" />
                    <NumberBox x:Name="BDay" Header="DD" Width="70" />
                    <NumberBox x:Name="BYear" Header="YYYY" Width="96" />
                </StackPanel>
                <PasswordBox x:Name="Pwd" Header="Password" />
                <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn"
                        HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock x:Name="Status" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- The session's hidden webview: never shown, holds the auth cookies. -->
            <WebView2 x:Name="Web" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
