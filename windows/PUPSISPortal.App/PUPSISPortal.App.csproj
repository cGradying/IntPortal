<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 app — Windows-only. NOT added to PUPSISPortal.slnx so the mac
       build of Core+Tests keeps working; add it to the solution on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PUPSISPortal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Unpackaged, self-contained: runs as a plain .exe, no MSIX needed to dev. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Kept in step with the mac app's version by hand (Scripts/make_dmg.sh);
         there's no shared version source across the two toolchains. -->
    <Version>1.1.1.0</Version>
    <FileVersion>1.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PUPSISPortal.Core\PUPSISPortal.Core.csproj" />
  </ItemGroup>

  <!-- The scraper JS ships beside the exe; SisScriptLoader reads it at runtime. -->
  <ItemGroup>
    <Content Include="..\assets\sis-scrapers\*.js">
      <Link>Assets\sis-scrapers\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The notes editor shell + bundle (copied verbatim from the mac app's
       Resources/notes-editor.bundle.js); NotesView reads both at runtime. -->
  <ItemGroup>
    <Content Include="..\assets\notes-editor\*">
      <Link>Assets\notes-editor\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
