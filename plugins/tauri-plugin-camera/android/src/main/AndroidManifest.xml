<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No CAMERA permission: the phone's own camera app takes the photo. Declaring it would make that intent need a grant. -->
    <application>
        <!-- Play installs the scanner's models with the app; read() covers a sideloaded install. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr,barcode" />
        <provider
            android:name="ph.intportal.camera.CameraFileProvider"
            android:authorities="${applicationId}.camera.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/camera_paths" />
        </provider>
    </application>
</manifest>
