<?xml version="1.0" encoding="utf-8"?>
<!-- Only where the WebView's camera input writes its photo (RustWebChromeClient.createImageFile):
     the app's own Pictures folder, not all of external storage or the cache. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-files-path name="my_images" path="Pictures/" />
</paths>
